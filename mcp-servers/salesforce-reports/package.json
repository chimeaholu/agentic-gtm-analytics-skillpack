  "description": "MCP server for the Salesforce Reports and Dashboards REST API — report execution, metadata, creation and dashboard clone, with Bulk API 2.0 as the escape hatch from the 2,000-row ceiling.",
  "license": "MIT",
  "type": "module",
  "bin": { "salesforce-reports-mcp": "dist/index.js" },
