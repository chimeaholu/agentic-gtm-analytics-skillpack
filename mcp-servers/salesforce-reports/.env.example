# ---------------------------------------------------------------------------
# Auth. Pick ONE flow. No tool ever accepts a credential as an argument.
# ---------------------------------------------------------------------------

# Login host. login.salesforce.com for production, test.salesforce.com for a sandbox.
# The API host is ALWAYS taken from instance_url in the token response, never from here.
SF_LOGIN_URL=https://login.salesforce.com

SF_API_VERSION=v60.0

# --- Flow 1: JWT bearer (recommended for unattended use) -------------------
SF_AUTH_FLOW=jwt
SF_CLIENT_ID=3MVG9...                      # the connected app's consumer key
SF_USERNAME=integration.user@example.com   # the pre-authorized integration user
SF_PRIVATE_KEY_B64=                        # base64 of the PEM private key (see README)

# --- Flow 2: client credentials --------------------------------------------
# SF_AUTH_FLOW=client_credentials
# SF_CLIENT_ID=3MVG9...
# SF_CLIENT_SECRET=...

# --- Flow 3: refresh token (human-in-the-loop / authorization code) --------
# SF_AUTH_FLOW=refresh_token
# SF_CLIENT_ID=3MVG9...
# SF_CLIENT_SECRET=...
# SF_REFRESH_TOKEN=...

# ---------------------------------------------------------------------------
# Write gate. OFF by default. With writes off, the write tools are not
# advertised at all — the agent cannot attempt what it cannot see.
# ---------------------------------------------------------------------------
SF_ENABLE_REPORT_WRITES=false

# Optional: restrict report creation to named folders (comma-separated folder ids
# or developer names). An approved capability still gets a bounded blast radius.
# SF_WRITE_FOLDER_ALLOWLIST=00l000000000000AAA,Shared_GTM_Reports

# ---------------------------------------------------------------------------
# Soft guards
# ---------------------------------------------------------------------------
# Bulk jobs whose estimate exceeds this require confirm_large_extract: true
SF_LARGE_EXTRACT_ROWS=250000

# Self-throttle ceilings (Salesforce org limits: 500 sync runs/hour, 1200 async/hour)
SF_MAX_SYNC_RUNS_PER_HOUR=450
SF_MAX_ASYNC_REQUESTS_PER_HOUR=1000
